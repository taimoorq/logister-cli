{
  "name": "logister-cli",
  "version": "0.1.1",
  "description": "Command-line access to Logister project telemetry for humans and AI tools.",
  "type": "module",
  "bin": {
    "logister": "bin/logister.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "contracts/",
    "docs/",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "sync:contract": "node scripts/sync-contract.mjs",
    "update:package-managers": "node scripts/update-package-manager-repos.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm test && node bin/logister.js version && node bin/logister.js help",
    "prepack": "npm run check:version"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taimoorq/logister-cli.git"
  },
  "bugs": {
    "url": "https://github.com/taimoorq/logister-cli/issues"
  },
  "homepage": "https://github.com/taimoorq/logister-cli#readme",
  "keywords": [
    "logister",
    "observability",
    "logs",
    "errors",
    "cli"
  ]
}
